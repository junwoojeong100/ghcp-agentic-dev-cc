+  for (const stale of [false, true]) {
+    test(`422 response body ${failure} preserves the current lock; stale=${stale}`, async (t) => {
+      const ui = await startUi(t);
+      await showPreview(ui, 'Q-1001', '0');
+      const sending = ui.get('#quote-form').dispatch('submit');
+      const request = ui.requests.at(-1);
+      const rejectBody = request.pendingBody(422);
+      await settleUi();
+      assert.equal(ui.get('#send-quote').disabled, true);
+      const [timer] = ui.timers;
+      if (stale) await showPreview(ui, 'Q-1500', '0');
+      let error;
+      if (failure === 'json') error = new SyntaxError('Invalid response JSON');
+      if (failure === 'network') error = new TypeError('Response stream disconnected');
+      if (failure === 'timeout') {
+        timer.callback();
+        assert.equal(request.signal.aborted, true);
+        error = new Error('Response body timed out');
+        error.name = 'AbortError';
+      }
+      rejectBody(error);
+      await sending;
+      assert.equal(ui.get('#send-quote').disabled, !stale);
+      assert.equal(ui.get('#quote-summary').getAttribute('aria-busy'), 'false');
+      assert.equal(ui.timers.size, 0);
+      if (stale) {
+        assert.equal(ui.get('#margin-value').textContent, '15.0%');
+        assert.equal(ui.get('#feedback').textContent, '');
+      } else {
